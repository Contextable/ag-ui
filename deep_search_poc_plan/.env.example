# =============================================================================
# Deep Search POC - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Google API Configuration (Required)
# -----------------------------------------------------------------------------

# Gemini API Key - Get from https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Custom Search API (if not using Gemini's built-in search)
# GOOGLE_SEARCH_API_KEY=your_search_api_key
# GOOGLE_SEARCH_ENGINE_ID=your_custom_search_engine_id

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------

# Default model for all agents (can be overridden per-agent)
DEFAULT_MODEL=gemini-2.0-flash

# Alternative models:
# - gemini-2.0-flash (fast, good for most tasks)
# - gemini-1.5-pro (more capable, slower)
# - gemini-1.5-flash (balanced)

# -----------------------------------------------------------------------------
# Research Configuration
# -----------------------------------------------------------------------------

# Maximum refinement iterations per section (1-5)
MAX_RESEARCH_ITERATIONS=3

# Maximum number of report sections
MAX_SECTIONS=10

# Minimum sources required per section
MIN_SOURCES_PER_SECTION=2

# Minimum passing grade for research quality (A, B, or C)
PASSING_GRADE=B

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------

# Backend server port
BACKEND_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------

# Backend agent URL (for CopilotKit runtime)
RESEARCH_AGENT_URL=http://localhost:8000/research

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------

# Enable debug logging
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
