# AG-UI Google Workspace Add-on Configuration

# Port for the HTTP server (default: 8080)
PORT=8080

# REQUIRED — Public HTTPS URL of this server.
# Used to build the `function` URLs for card action buttons (Send, Approve, etc.).
# Use your ngrok URL for local dev, or your Cloud Run URL in production.
ACTION_BASE_URL=https://your-ngrok-url.ngrok.dev

# Default backend URL (used if user hasn't configured their own).
# For the Python workspace agent in ../python, run its server on port 8001
# and point at its root (the agent is mounted at "/").
AGUI_DEFAULT_BACKEND_URL=http://localhost:8001/

# Allowed backend URL patterns (comma-separated, optional)
# Use *.example.com to allow all subdomains
# AGUI_ALLOWED_BACKENDS=*.example.com,agent.internal.co

# Set to 1 to inline host-app context (email body, event details, etc.)
# into the user message text. Use this for AG-UI backends that don't read
# RunAgentInput.context on the server side.
# INLINE_CONTEXT=1

# Google Cloud Project ID (enables Firestore session store)
# GOOGLE_CLOUD_PROJECT=my-project-id
# FIRESTORE_PROJECT_ID=my-project-id
